rules_version = '2';
// Contrail security rules: Google sign-in only, admin approves members, admin-only system settings.
// Replace omriidan20@gmail.com with the Google account email of the admin.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isGoogle() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function isAdmin()  { return isGoogle() && request.auth.token.email == 'omriidan20@gmail.com' && request.auth.token.email_verified == true; }
    function isMember() {
      return isAdmin() || (isGoogle()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.status == 'approved');
    }

    // System settings (live-data keys): approved members can read, only the admin can change
    match /config/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }
    // Access requests: a person may request access for themselves; only the admin approves
    match /members/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isGoogle() && request.auth.uid == uid && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    // Flight-alert subscriptions. Encrypted in the app so only the alert sender can read them.
    match /push/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isMember();
    }
    // Calendar feeds: the link holds a random token; the Contrail server reads it, only the owner can change it
    match /cal/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update: if isMember() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Each member's own flights
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid && isMember();
    }
  }
}
